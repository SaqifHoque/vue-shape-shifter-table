{
  "name": "vue-shapeshifter-table",
  "version": "1.0.0",
  "description": "A responsive, editable, shape-shifting table component for Vue 3.",
  "author": "Saqif Haque",
  "homepage": "https://github.com/SaqifHoque/vue-shape-shifter-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaqifHoque/vue-shape-shifter-table.git"
  },
  "bugs": {
    "url": "https://github.com/SaqifHoque/vue-shape-shifter-table/issues"
  },
  "type": "module",
  "module": "dist/vue-shapeshifter-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/vue-shapeshifter-table.js"
    },
    "./style.css": "./dist/vue-shapeshifter-table.css"
  },
  "files": [
    "dist",
    "SECURITY.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "vue3",
    "table",
    "data-grid",
    "editable-table",
    "responsive-table"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "predev": "npm run build",
    "dev": "vite",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:types": "npm run build && vue-tsc -p tests/types/tsconfig.json",
    "build": "vite build",
    "prebuild:demo": "npm run build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --mode demo",
    "security:audit": "npm audit --audit-level=moderate",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run security:audit"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vue": "^3.5.20",
    "vue-tsc": "^3.3.11"
  }
}
